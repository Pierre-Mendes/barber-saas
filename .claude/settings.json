{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["codegraph", "serena", "barber-docs"],
  "permissions": {
    "allow": [
      "mcp__barber-docs__docs_search",
      "mcp__barber-docs__docs_rebuild",
      "mcp__codegraph__codegraph_explore",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__find_implementations",
      "mcp__serena__find_declaration",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__read_memory",
      "mcp__serena__list_memories",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run rag:*)",
      "Bash(npm run rag -- :*)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npx -y @colbymchenry/codegraph@1 :*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Bash(npx prisma migrate reset:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/harness/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
