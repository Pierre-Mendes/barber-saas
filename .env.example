# Banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barber?schema=public"

# Nome da plataforma (aparece só nas telas da plataforma, nunca na página da barbearia)
NEXT_PUBLIC_PLATFORM_NAME="Agenda Barber"

# Domínio raiz da plataforma. Barbearias ficam em <slug>.<ROOT_DOMAIN>.
# Em dev, navegadores resolvem *.localhost automaticamente.
ROOT_DOMAIN="localhost:3000"
APP_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET="troque-por-uma-string-aleatoria-longa"
AUTH_TRUST_HOST=true
# Opcional: login com Google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail (dev: Mailpit em http://localhost:8025)
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="Agenda <nao-responda@localhost>"

# Web Push (gere com: npm run vapid:generate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:suporte@exemplo.com"

# Protege o endpoint de lembretes (/api/cron/reminders)
CRON_SECRET="troque-me"
